# Site URL (for OG tags)
NEXT_PUBLIC_SITE_URL=https://gotcha.it.com

# API Base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Kakao Map API Key
NEXT_PUBLIC_KAKAO_MAP_KEY=your_kakao_map_key_here

# OAuth
NEXT_PUBLIC_KAKAO_OAUTH_CLIENT_ID=your_kakao_oauth_client_id
NEXT_PUBLIC_NAVER_OAUTH_CLIENT_ID=your_naver_oauth_client_id
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id

# Figma API
FIGMA_ACCESS_TOKEN=your_figma_access_token

# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Sentry (https://sentry.io)
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxx@oXXXXXX.ingest.sentry.io/XXXXXX
# 소스맵 업로드 (빌드 시점에만 필요, 절대 클라이언트 노출 금지)
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here
# 릴리스 식별자 (선택, CI에서 git sha 등으로 주입)
# NEXT_PUBLIC_SENTRY_RELEASE=
